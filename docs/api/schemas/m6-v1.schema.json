{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M6 v1 frozen contract definitions",
  "description": "Select a $defs schema. Cross-field ordering, identity derivation, owner lineage, <=8KiB receipts and transactional invariants are specified in m6-projection-memory-world-v1.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/memorySummary"
    },
    {
      "$ref": "#/$defs/worldSnapshot"
    },
    {
      "$ref": "#/$defs/worldDeltaPage"
    },
    {
      "$ref": "#/$defs/worldResyncRequired"
    },
    {
      "$ref": "#/$defs/projectionInput"
    },
    {
      "$ref": "#/$defs/projectionJob"
    }
  ],
  "$defs": {
    "projection": {
      "type": "object",
      "properties": {
        "model_version": {
          "const": "learner-projection/v1"
        },
        "source_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "source_head_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "status": {
          "enum": [
            "CURRENT",
            "PENDING",
            "FAILED"
          ]
        }
      },
      "required": [
        "model_version",
        "source_sequence",
        "source_head_sequence",
        "status"
      ],
      "additionalProperties": false
    },
    "preferences": {
      "type": "object",
      "properties": {
        "adventure_preference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "preferred_effort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "support_style": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "practical_opt_in": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "adventure_preference",
        "preferred_effort",
        "support_style",
        "practical_opt_in",
        "version"
      ],
      "additionalProperties": false
    },
    "explicitInterest": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "entity_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "preference": {
          "enum": [
            "NEUTRAL",
            "MORE",
            "LESS",
            "PAUSED",
            "NOT_INTERESTED"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "availability": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        }
      },
      "required": [
        "entity_id",
        "entity_version",
        "title",
        "preference",
        "version",
        "updated_at",
        "availability"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "AVAILABLE"
              }
            }
          },
          "then": {
            "properties": {
              "entity_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "const": "UNAVAILABLE"
              }
            }
          },
          "then": {
            "properties": {
              "entity_version": {
                "type": "null"
              },
              "title": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "recentExploration": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "entity_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "started_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "completed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "latest_activity_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "entity_id",
        "entity_version",
        "title",
        "started_count",
        "returned_count",
        "completed_count",
        "latest_activity_at"
      ],
      "additionalProperties": false
    },
    "recognitionEvidence": {
      "type": "object",
      "properties": {
        "objective_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "entity_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "entity_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "support_required": {
          "type": "boolean"
        },
        "last_evidence_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "summary": {
          "const": "Recognition evidence recorded."
        }
      },
      "required": [
        "objective_id",
        "entity_id",
        "entity_version",
        "evidence_count",
        "support_required",
        "last_evidence_at",
        "summary"
      ],
      "additionalProperties": false
    },
    "memorySummary": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "memory-summary/v1"
        },
        "projection": {
          "$ref": "#/$defs/projection"
        },
        "learning_preferences": {
          "anyOf": [
            {
              "$ref": "#/$defs/preferences"
            },
            {
              "type": "null"
            }
          ]
        },
        "explicit_interests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/explicitInterest"
          },
          "maxItems": 20
        },
        "recently_explored": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recentExploration"
          },
          "maxItems": 10
        },
        "recognition_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recognitionEvidence"
          },
          "maxItems": 10
        },
        "long_term_interests": {
          "type": "array",
          "maxItems": 0
        },
        "voluntary_revisits": {
          "type": "array",
          "maxItems": 0
        },
        "truncated": {
          "type": "object",
          "properties": {
            "explicit_interests": {
              "type": "boolean"
            },
            "recently_explored": {
              "type": "boolean"
            },
            "recognition_evidence": {
              "type": "boolean"
            }
          },
          "required": [
            "explicit_interests",
            "recently_explored",
            "recognition_evidence"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_version",
        "projection",
        "learning_preferences",
        "explicit_interests",
        "recently_explored",
        "recognition_evidence",
        "long_term_interests",
        "voluntary_revisits",
        "truncated"
      ],
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "region_key": {
          "const": "discovery"
        },
        "primary_domain_id": {
          "type": "null"
        },
        "logical_x": {
          "const": 0
        },
        "logical_y": {
          "const": 0
        },
        "logical_width": {
          "const": 1
        },
        "logical_height": {
          "const": 1
        },
        "visual_archetype": {
          "const": "grove"
        }
      },
      "required": [
        "id",
        "region_key",
        "primary_domain_id",
        "logical_x",
        "logical_y",
        "logical_width",
        "logical_height",
        "visual_archetype"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "entity_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "entity_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "region_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "logical_x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "logical_y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "depth": {
          "const": 0
        },
        "visual_archetype": {
          "const": "branching_tree"
        },
        "visual_seed": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "growth_state": {
          "enum": [
            "SEED",
            "SPROUT",
            "YOUNG"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "id",
        "entity_id",
        "entity_version",
        "region_id",
        "logical_x",
        "logical_y",
        "depth",
        "visual_archetype",
        "visual_seed",
        "growth_state",
        "revision"
      ],
      "additionalProperties": false
    },
    "worldSnapshot": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "layout_version": {
          "const": 1
        },
        "generation_seed": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          },
          "maxItems": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "connections": {
          "type": "array",
          "maxItems": 0
        },
        "artifacts": {
          "type": "array",
          "maxItems": 0
        }
      },
      "required": [
        "revision",
        "layout_version",
        "generation_seed",
        "regions",
        "nodes",
        "connections",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "worldChange": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "type": {
              "const": "REGION_ADDED"
            },
            "object_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "payload": {
              "type": "object",
              "properties": {
                "schema_version": {
                  "const": "world-delta/v1"
                },
                "object": {
                  "$ref": "#/$defs/region"
