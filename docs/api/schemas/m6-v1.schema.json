              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "payload": {
              "type": "object",
              "properties": {
                "schema_version": {
                  "const": "world-delta/v1"
                },
                "object": {
                  "$ref": "#/$defs/node"
                }
              },
              "required": [
                "schema_version",
