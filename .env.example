# Embyr database configuration. Names only; never commit values.
#
# EMBYR_DATABASE_URL selects the database for the current process. Supply the
# least-privileged role for each component, injected per process:
#   Alembic migrations -> app_owner
#   FastAPI runtime    -> app_backend
#   background worker  -> app_worker
#
# Provide real credentials through secure environment/secret storage only.
# On Supabase, use the IPv4 shared pooler (Supavisor Session mode, port 5432)
# with the role-scoped username `<role>.<project-ref>` unless a direct
# IPv6 connection or the paid IPv4 add-on is available.
#
# The URL MUST require TLS: append `?sslmode=require`, or use
# `sslmode=verify-full` with the downloaded server certificate and
# `sslrootcert`. libpq defaults to `sslmode=prefer`, which can silently fall
# back to plaintext.
EMBYR_DATABASE_URL=

# Optional dedicated disposable test database. Its name must contain "test".
# Without it, database tests start PostgreSQL+pgvector via Testcontainers.
EMBYR_TEST_DATABASE_URL=
